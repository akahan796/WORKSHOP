# These are set in the Vercel dashboard (Project → Settings → Environment Variables),
# NOT committed to git. This file just documents the variables you need.

# The password reviewers type on the login screen (viewer role).
ACCESS_PASSWORD=change-me

# A long random secret — the value stored in the session cookie. Generate one with:
#   openssl rand -hex 32
# Treat it like a password. If you rotate it, everyone is signed out.
SESSION_TOKEN=replace-with-a-long-random-string

# OPTIONAL — only needed once a review frame with editable UX notes exists.
# Editor login password (can add/move/remove UX notes).
# EDITOR_PASSWORD=change-me-too
# HttpOnly write-gate token for the shared notes store.
# EDIT_TOKEN=another-long-random-string
